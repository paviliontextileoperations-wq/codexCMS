# PostgreSQL connection used by the desktop database scripts.
# Local example:
DATABASE_URL=postgres://cms_app:change_me@localhost:5432/cms

# AWS RDS commonly requires SSL. Keep false for a local PostgreSQL server.
PGSSL=false

# Use false only when a managed provider gives a certificate chain that Node cannot verify.
PGSSL_REJECT_UNAUTHORIZED=true

# 1.2.0 cloud API mode. When API_BASE_URL is set, the desktop app uses the API
# and does not connect directly to PostgreSQL.
# API_BASE_URL=https://example.execute-api.eu-south-2.amazonaws.com
# API_KEY=replace_with_generated_api_key

# S3 image storage used by the cloud API.
# S3_BUCKET=pavilion-cms-assets-account-region
# S3_BASE_PREFIX=products
